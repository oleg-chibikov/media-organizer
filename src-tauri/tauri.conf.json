{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media Organizer",
  "version": "0.2.0",
  "identifier": "com.mediaorganizer.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Media Organizer",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app"],
    "createUpdaterArtifacts": true,
    "publisher": "Media Organizer",
    "shortDescription": "Organize NAS media TODO folder.",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/exiftool"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxREVDRkVCMTA2QUUxM0IKUldRNzRXb1E2OC9lOGFoanlBWHJQNHhnQ3k1aUI2amRySTcxbTgzaTBESU9JQ3ZGSU9OZGRNbmgK",
      "endpoints": [
        "https://github.com/oleg-chibikov/media-organizer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
